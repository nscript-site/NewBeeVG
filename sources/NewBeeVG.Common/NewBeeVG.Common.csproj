<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.1.28</Version>
    <RepositoryUrl>https://github.com/nscript-site/NewBeeVG</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>NewBeeVG.Common</PackageId>
    <PackageTags>avalonia,NewBeeVG</PackageTags>
    <PackageProjectUrl>https://github.com/nscript-site/NewBeeVG</PackageProjectUrl>
    <Copyright>geblab.com</Copyright>
    <Title>NewBeeVG: An AI coding-powered tool for fast procedural animation and video creation</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>False</IncludeSymbols>
    <Company>geblab</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="newbeeui" />
  </ItemGroup>
</Project>
